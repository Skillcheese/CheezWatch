{
  "manifest_version": 3,
  "name": "ScapeWatch Companion",
  "version": "0.2.0",
  "description": "Read-only side panel for ScapeWatch: passively observes the game's traffic and hosts Gauntlet Lab.",
  "permissions": ["debugger", "sidePanel"],
  "host_permissions": ["https://scapewatch.com/*", "https://*.scapewatch.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel/index.html" },
  "action": { "default_title": "ScapeWatch Companion" }
}
