{
  "name": "scapewatch-companion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "CheezWatch: a website that fills Gauntlet Lab from ScapeWatch screenshots",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build:lab": "cd gauntlet_lab && npm install && npm run build && cd .. && node scripts/copy-lab.js",
    "build:standalone": "node scripts/copy-tesseract.js",
    "serve": "node scripts/serve.js",
    "test": "node --test standalone/*.test.js standalone/lib/*.test.js standalone/vision/*.test.js",
    "build:site": "node scripts/bundle-site.js"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@napi-rs/canvas": "^0.1.65",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^5.1.1"
  }
}
